#[cfg(feature = "scheduler_dispatch_test")]
#[derive(Clone, Copy, PartialEq, Eq)]
pub enum DispatchResult {
    NoRunnableTask,
    Failed,
}

#[cfg(feature = "scheduler_dispatch_test")]
#[derive(Clone, Copy, PartialEq, Eq)]
pub enum RunOnceResult {
    NoRunnableTask,
    Failed,
}

#[cfg(feature = "scheduler_run_test")]
